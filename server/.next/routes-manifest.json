{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/admin/content/[resource]",
      "regex": "^/api/admin/content/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPresource": "nxtPresource"
      },
      "namedRegex": "^/api/admin/content/(?<nxtPresource>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/admin/content/[resource]/[id]",
      "regex": "^/api/admin/content/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPresource": "nxtPresource",
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/admin/content/(?<nxtPresource>[^/]+?)/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/admin/[key]",
      "regex": "^/api/admin/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPkey": "nxtPkey"
      },
      "namedRegex": "^/api/admin/(?<nxtPkey>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/cms/content/[id]/draft",
      "regex": "^/api/cms/content/([^/]+?)/draft(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/cms/content/(?<nxtPid>[^/]+?)/draft(?:/)?$"
    },
    {
      "page": "/api/cms/pages/[slug]/content",
      "regex": "^/api/cms/pages/([^/]+?)/content(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/api/cms/pages/(?<nxtPslug>[^/]+?)/content(?:/)?$"
    },
    {
      "page": "/api/cms/pages/[slug]/publish",
      "regex": "^/api/cms/pages/([^/]+?)/publish(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/api/cms/pages/(?<nxtPslug>[^/]+?)/publish(?:/)?$"
    },
    {
      "page": "/api/services/[slug]",
      "regex": "^/api/services/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/api/services/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
