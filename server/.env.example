# PostgreSQL connection used by the Next.js API
DATABASE_URL=postgresql://cybergys:cybergys_local_password@127.0.0.1:5433/cybergys
# Required for secure admin sessions. Set ADMIN_EMAIL and ADMIN_PASSWORD once to bootstrap the first account.
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
